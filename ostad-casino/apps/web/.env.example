# ─────────────────────────────────────────────────────────────
# OSTAD CASINO — environment template. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Application mode. The shipped application is DEMO ONLY.
APP_MODE=DEMO
DEMO_MODE=true
REAL_MONEY_ENABLED=false

# Session signing secret (32+ random bytes). Required outside development.
SESSION_SECRET=
# Public base URL used for SIWE-style message domain binding.
APP_URL=http://localhost:3000

# Data stores. When DATABASE_URL is empty the app uses the local
# demo persistence file store (.data/store.json) and PostgreSQL is
# reported as DEGRADED in the admin system health panel.
DATABASE_URL=
REDIS_URL=

# Chain RPC endpoints (read-only status adapters; no signing, no keys).
BSC_RPC_URL=
POLYGON_RPC_URL=
TRON_RPC_URL=

# Wallet UI
WALLETCONNECT_PROJECT_ID=

# Network feature flags
BSC_ENABLED=true
POLYGON_ENABLED=true
TRON_ENABLED=true
DEMO_CHAIN_ID=false

# Game feature flags
POKER_ENABLED=true
ROULETTE_ENABLED=true
BLACKJACK_ENABLED=true
SLOTS_ENABLED=true

# Admin console access. If empty, /admin stays locked (fail closed).
ADMIN_ACCESS_KEY=
